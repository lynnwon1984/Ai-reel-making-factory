{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stable Storyboard Plan v4",
  "type": "object",
  "required": ["schemaVersion", "sceneId", "shots"],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "sceneId": {
      "type": "string"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "duration",
          "cast",
          "props",
          "startState",
          "stateChange",
          "endState",
          "cameraReason",
          "continuityNote",
          "clips"
        ],
        "properties": {
          "duration": {
            "type": "integer",
            "minimum": 5,
            "maximum": 15
          },
          "cast": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startState": {
            "type": "string",
            "minLength": 1
          },
          "stateChange": {
            "type": "string",
            "minLength": 1
          },
          "endState": {
            "type": "string",
            "minLength": 1
          },
          "cameraReason": {
            "type": "string",
            "minLength": 1
          },
          "continuityNote": {
            "type": "string",
            "minLength": 1
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "duration",
                "size",
                "cameraMove",
                "visualAction",
                "beat"
              ],
              "properties": {
                "duration": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 15
                },
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "cameraMove": {
                  "type": "string",
                  "minLength": 1
                },
                "visualAction": {
                  "type": "string",
                  "minLength": 1
                },
                "beat": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceBlockIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "actionUnitIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dialogueContinuationIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "anyOf": [
                {
                  "required": ["sourceBlockIds"]
                },
                {
                  "required": ["actionUnitIds"]
                },
                {
                  "required": ["dialogueContinuationIds"]
                }
              ]
            }
          }
        }
      }
    }
  }
}
